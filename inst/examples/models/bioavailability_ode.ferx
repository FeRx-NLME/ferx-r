# Oral bioavailability — ODE implementation of one-compartment oral model
#
# Demonstrates logit-transformed bioavailability F in an ODE context.
# This is the ODE equivalent of bioavailability.ferx (same data, same true
# parameters) — useful for verifying the ODE and analytical paths agree.
#
# F is the oral bioavailability, constrained to (0,1) via logit transform.
#
# ── ODE unit convention ────────────────────────────────────────────────────
# ferx loads the dose into the state with bioavailability applied by the
# engine: u[cmt-1] += F * dose.amt (an `F` individual parameter is recognised
# automatically). F must therefore NOT also appear in the [odes] RHS, or it
# would be counted twice.
# Oral doses (CMT=1, AMT=100 mg) go to the depot (amount) compartment; states
# are AMOUNTS and the observed concentration is central / V, read out via
# `[scaling] obs_scale = V` (the same amount + obs_scale convention used by the
# other ODE examples, e.g. warfarin_ode).
#
# States:
#   CMT=1  depot     — oral dose amount (mg)
#   CMT=2  central   — central amount (mg); concentration = central / V
#
# Dataset: data/bioavailability_ode.csv (oral-only, 20 subjects × 7 obs)
#
# True simulation parameters:
#   TVCL=5, TVV=50, TVKA=1.5, F=0.70, omega_CL=0.09,
#   omega_F=0.10, sigma_prop=0.15

[parameters]
  theta TVCL(5.0,   0.1,  50.0)    # typical clearance (L/h)
  theta TVV(50.0,   5.0, 500.0)    # typical volume (L)
  theta TVKA(1.5,  0.05,  20.0)    # typical absorption rate constant (/h)
  theta THETA_F(0.70, 0.001, 0.999) # typical bioavailability, directly on (0,1) scale

  omega ETA_CL ~ 0.09              # BSV on CL (log-normal)
  omega ETA_F  ~ 0.10              # BSV on F  (logit-normal)

  sigma PROP_ERR ~ 0.15 (sd)

[individual_parameters]
  CL = TVCL * exp(ETA_CL)
  V  = TVV
  KA = TVKA
  F  = inv_logit(logit(THETA_F) + ETA_F)  # individual bioavailability ∈ (0, 1)

[structural_model]
  ode(obs_cmt=central, states=[depot, central])

[odes]
  # depot  : oral-dose amount (mg)
  # central: central amount (mg); concentration = central / V via [scaling]
  # F is applied by the engine at the dose (see unit-convention note above),
  # so the absorption flux is plain KA * depot -- no F here.
  d/dt(depot)   = -KA * depot
  d/dt(central) =  KA * depot - (CL/V) * central

[scaling]
  obs_scale = V

[error_model]
  DV ~ proportional(PROP_ERR)

[fit_options]
  method     = focei
  maxiter    = 500
  covariance = true
