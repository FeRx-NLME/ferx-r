# Parallel (dual first-order) absorption -- first_order() composition (ferx-core #505).
# Two parallel first-order absorption pathways (a fast + a slow one) feeding the
# central compartment, split by a declared dose fraction:
#
#   R_in(tad) = FR1*first_order(ka=KA1) + FR2*first_order(ka=KA2),   FR1 + FR2 = 1
#
# first_order(ka) is the classic first-order (Bateman) absorption exposed as an
# input-rate function so two pathways can be composed in one ODE (standalone
# first-order still uses the analytical pk *_oral path). Each FR*first_order(...)
# multiplier must be a single declared individual parameter (not an expression like
# (1-FR)), so the complementary fraction is declared explicitly (FR2 = 1 - FR1). The
# two pathways together deliver exactly the dose; both are smooth exp-only densities,
# so the model keeps exact analytic FOCEI gradients (including the d/dFR1 sensitivity).
#
# Paired with the ferx-core NONMEM absorption anchor data (igd_oral.csv), which was
# simulated from a transit model -- so this parallel fit is mildly mis-specified: a
# syntax / workflow demo, not parameter recovery. The matched, recovering anchor is
# ferx-core nonmem_anchor/parallel_first_order.ctl (ferx vs NONMEM OFV to ~1e-5).

[parameters]
  theta TVCL(5.0,    0.1, 100.0)
  theta TVV(50.0,    5.0, 500.0)
  theta TVFR1(0.6,  0.05,  0.95)   # fraction of dose through the fast pathway
  theta TVKA1(1.5,  0.05,  24.0)   # absorption rate, fast pathway (1/h)
  theta TVKA2(0.3,  0.01,  24.0)   # absorption rate, slow pathway (1/h)

  omega ETA_CL ~ 0.09
  omega ETA_V  ~ 0.09

  sigma PROP_ERR ~ 0.15 (sd)

[individual_parameters]
  CL  = TVCL * exp(ETA_CL)
  V   = TVV  * exp(ETA_V)
  FR1 = TVFR1                      # fast-pathway fraction
  FR2 = 1 - TVFR1                  # declared complement (FR1 + FR2 = 1)
  KA1 = TVKA1
  KA2 = TVKA2

[structural_model]
  ode(states=[central])            # central holds drug AMOUNT; concentration = A/V

[odes]
  d/dt(central) = FR1*first_order(ka=KA1) + FR2*first_order(ka=KA2) - CL/V*central

[scaling]
  y = central / V                  # observable = concentration (mg/L)

[error_model]
  DV ~ proportional(PROP_ERR)

[fit_options]
  method  = focei
  maxiter = 500
