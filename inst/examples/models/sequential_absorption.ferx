# Sequential (zero-order then first-order) absorption.
#
# A two-step absorption model composing the built-in `zero_order()` input rate
# with a hand-written first-order transfer -- there is no dedicated `sequential`
# keyword. A zero-order input fills a depot at a constant rate over (0, DUR], and
# the depot empties to central by first-order `ka`:
#
#   d/dt(depot)   = zero_order(dur=DUR) - KA*depot
#   d/dt(central) = KA*depot - CL/V*central
#
# The dose feeds zero_order() (its bolus is suppressed); the full dose still
# reaches central (integral into central = F*Dose). `central` is an AMOUNT;
# concentration = amount / V via [scaling].
#
# Paired with sequential_absorption.csv, simulated (independently, via deSolve)
# from this structure at TVCL=5, TVV=50, TVKA=1, TVDUR=3, omega_CL=omega_V=0.09,
# sigma_prop=0.15 -- see sequential_absorption/simulate_dataset.R. The dose is
# into the depot (CMT 1); central (CMT 2) is observed.

[parameters]
  theta TVCL(5.0,   0.1, 100.0)   # clearance (L/h)
  theta TVV(50.0,   5.0, 500.0)   # central volume (L)
  theta TVKA(1.0,  0.05,  24.0)   # first-order depot->central rate (1/h)
  theta TVDUR(3.0, 0.05,  24.0)   # zero-order input duration (h)

  omega ETA_CL ~ 0.09
  omega ETA_V  ~ 0.09

  sigma PROP_ERR ~ 0.15 (sd)

[individual_parameters]
  CL  = TVCL * exp(ETA_CL)
  V   = TVV  * exp(ETA_V)
  KA  = TVKA
  DUR = TVDUR

[structural_model]
  ode(obs_cmt=central, states=[depot, central])

[odes]
  d/dt(depot)   = zero_order(dur=DUR) - KA*depot
  d/dt(central) = KA*depot - CL/V*central

[scaling]
  y = central / V

[error_model]
  DV ~ proportional(PROP_ERR)

[fit_options]
  method  = focei
  maxiter = 500
