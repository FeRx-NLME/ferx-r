# One-compartment oral PK model (warfarin) with regular-vine random effects (`omega_dist = vine`).
#
# Shares `warfarin.csv` with `warfarin.ferx`: estimates zero-mean flexible marginals
# and a 3-ETA regular-vine copula over (ETA_CL, ETA_V, ETA_KA) under SAEM.

[data]
  path = ../data/warfarin.csv

[parameters]
  theta TVCL(0.134, 0.001, 10.0)
  theta TVV(8.1, 0.1, 500.0)
  theta TVKA(1.0, 0.01, 50.0)

  omega ETA_CL ~ 0.07
  omega ETA_V  ~ 0.02
  omega ETA_KA ~ 0.40

  sigma PROP_ERR ~ 0.10 (sd)

[individual_parameters]
  CL = TVCL * exp(ETA_CL)
  V  = TVV  * exp(ETA_V)
  KA = TVKA * exp(ETA_KA)

[structural_model]
  pk one_cpt_oral(cl=CL, v=V, ka=KA)

[error_model]
  DV ~ proportional(PROP_ERR)

[fit_options]
  method        = saem
  omega_dist    = vine
  saem_ofv      = imp
  n_exploration = 200
  n_convergence = 250
  seed          = 12345
  covariance    = true
