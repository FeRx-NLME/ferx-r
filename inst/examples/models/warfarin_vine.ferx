# One-compartment oral PK model (warfarin) — vine-copula SAEM.
#
# `omega_dist = vine` replaces the multivariate-normal Omega with a D-vine
# copula over the marginal eta distributions, capturing non-Gaussian dependence
# (e.g. lower-tail dependence between clearance and volume) that an MVN Omega
# cannot represent. SAEM only; see the ferx-core "Vine-Copula SAEM" docs page.

[parameters]
  theta TVCL(0.134, 0.001, 10.0)
  theta TVV(8.1, 0.1, 500.0)
  theta TVKA(1.0, 0.01, 50.0)

  omega ETA_CL ~ 0.07
  omega ETA_V  ~ 0.02

  sigma PROP_ERR ~ 0.01 (sd)

[individual_parameters]
  CL = TVCL * exp(ETA_CL)
  V  = TVV  * exp(ETA_V)
  KA = TVKA

[structural_model]
  pk one_cpt_oral(cl=CL, v=V, ka=KA)

[error_model]
  DV ~ proportional(PROP_ERR)

[fit_options]
  method          = saem
  omega_dist      = vine   # D-vine copula over the eta marginals (SAEM only)
  n_exploration   = 150
  n_convergence   = 250
  n_mh_steps      = 3
  omega_burnin    = 20    # hold the copula fixed while the sampler warms up
  adapt_interval  = 10
  seed            = 12345
  covariance      = true
