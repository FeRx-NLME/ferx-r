# Biphasic inverse-Gaussian (Freijer & Post) absorption -- shared pathway-fraction
# mechanism (ferx-core #388). Two parallel inverse-Gaussian absorption pathways (a
# fast + a slow one) feeding the central compartment, split by a dose fraction:
#
#   R_in(tad) = FR1*igd(MAT1, CV2_1) + FR2*igd(MAT2, CV2_2),   FR1 + FR2 = 1
#
# Each FR*igd(...) multiplier must be a single declared individual parameter (not an
# expression like (1-FR)), so the complementary fraction is declared explicitly
# (FR2 = 1 - FR1). The two pathways together deliver exactly the dose.
#
# Paired with the ferx-core NONMEM absorption anchor data (igd_oral.csv), which was
# simulated from a transit model -- so this biphasic fit is mildly mis-specified: a
# syntax / workflow demo, not parameter recovery. The matched, recovering anchor is
# ferx-core nonmem_anchor/freijer_biphasic_ig.ctl (ferx vs NONMEM OFV to ~1e-5).

[parameters]
  theta TVCL(5.0,    0.1, 100.0)
  theta TVV(50.0,    5.0, 500.0)
  theta TVFR1(0.6,  0.05,  0.95)   # fraction through the fast pathway
  theta TVMAT1(0.5, 0.05,  24.0)   # mean absorption time, fast pathway (h)
  theta TVMAT2(4.0, 0.05,  24.0)   # mean absorption time, slow pathway (h)
  theta TVCV2_1(0.2, 0.001, 10.0)  # relative dispersion, fast pathway
  theta TVCV2_2(0.5, 0.001, 10.0)  # relative dispersion, slow pathway

  omega ETA_CL ~ 0.09
  omega ETA_V  ~ 0.09

  sigma PROP_ERR ~ 0.15 (sd)

[individual_parameters]
  CL    = TVCL * exp(ETA_CL)
  V     = TVV  * exp(ETA_V)
  FR1   = TVFR1
  FR2   = 1 - TVFR1                # declared complement (FR1 + FR2 = 1)
  MAT1  = TVMAT1
  MAT2  = TVMAT2
  CV2_1 = TVCV2_1
  CV2_2 = TVCV2_2

[structural_model]
  ode(states=[central])            # central holds drug AMOUNT; concentration = A/V

[odes]
  d/dt(central) = FR1*igd(mat=MAT1, cv2=CV2_1) + FR2*igd(mat=MAT2, cv2=CV2_2) - CL/V*central

[scaling]
  y = central / V                  # observable = concentration (mg/L)

[error_model]
  DV ~ proportional(PROP_ERR)

[fit_options]
  method  = focei
  maxiter = 500
