# Mixed (zero-order + first-order) absorption -- first_order() / zero_order()
# composition (ferx-core #505). Two parallel absorption pathways feeding the central
# compartment, split by a declared dose fraction: a zero-order (constant-rate) input
# over a modeled duration, plus a first-order input -- the classic "mixed" model:
#
#   R_in(tad) = FZO*zero_order(dur=DUR) + FZO1*first_order(ka=KA),   FZO + FZO1 = 1
#
# Each FR*fn(...) multiplier must be a single declared individual parameter (not an
# expression like (1-FZO)), so the first-order fraction is declared explicitly
# (FZO1 = 1 - FZO); the two pathways together deliver exactly the dose. The zero-order
# pathway has a hard cutoff at tad = DUR, so -- like a plain zero_order() model -- DUR
# and the zero-order fraction FZO are differentiated by finite differences; the
# first-order pathway is a smooth exp-only density.
#
# Paired with the ferx-core NONMEM absorption anchor data (igd_oral.csv), which was
# simulated from a transit model -- so this mixed fit is mildly mis-specified: a
# syntax / workflow demo, not parameter recovery. The matched, recovering anchor is
# ferx-core nonmem_anchor/mixed_zero_first.ctl (ferx vs NONMEM OFV to ~1e-4).

[parameters]
  theta TVCL(5.0,    0.1, 100.0)
  theta TVV(50.0,    5.0, 500.0)
  theta TVFZO(0.4,  0.05,  0.95)   # fraction of dose through the zero-order pathway
  theta TVKA(1.0,   0.05,  24.0)   # first-order absorption rate (1/h)
  theta TVDUR(3.0,  0.05,  24.0)   # zero-order input duration (h)

  omega ETA_CL ~ 0.09
  omega ETA_V  ~ 0.09

  sigma PROP_ERR ~ 0.15 (sd)

[individual_parameters]
  CL   = TVCL * exp(ETA_CL)
  V    = TVV  * exp(ETA_V)
  FZO  = TVFZO                     # zero-order-pathway fraction
  FZO1 = 1 - TVFZO                 # declared complement (FZO + FZO1 = 1)
  KA   = TVKA
  DUR  = TVDUR

[structural_model]
  ode(states=[central])            # central holds drug AMOUNT; concentration = A/V

[odes]
  d/dt(central) = FZO1*first_order(ka=KA) + FZO*zero_order(dur=DUR) - CL/V*central

[scaling]
  y = central / V                  # observable = concentration (mg/L)

[error_model]
  DV ~ proportional(PROP_ERR)

[fit_options]
  method  = focei
  maxiter = 500
