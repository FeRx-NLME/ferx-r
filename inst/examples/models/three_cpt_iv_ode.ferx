# Three-compartment IV PK model -- ODE form of three_cpt_iv.ferx.
#
# ODE transcription of the analytical `three_cpt_iv` closed form. Same data
# (three_cpt_iv.csv) and parameters as three_cpt_iv.ferx; the two must yield
# identical predictions (see tests/testthat/test-ode-analytical-equivalence.R).
#
# Convention: states are AMOUNTS; observed concentration is central / V1.
# Micro-constants: k12 = Q2/V1, k21 = Q2/V2, k13 = Q3/V1, k31 = Q3/V3,
# k10 = CL/V1.

[parameters]
  theta TVCL(5.0, 0.1, 100.0)
  theta TVV1(10.0, 0.1, 500.0)
  theta TVQ2(2.0, 0.01, 50.0)
  theta TVV2(20.0, 0.1, 1000.0)
  theta TVQ3(1.5, 0.01, 50.0)
  theta TVV3(30.0, 0.1, 1000.0)

  omega ETA_CL ~ 0.09
  omega ETA_V1 ~ 0.04
  omega ETA_Q2 ~ 0.04
  omega ETA_V2 ~ 0.04
  omega ETA_Q3 ~ 0.04
  omega ETA_V3 ~ 0.04

  sigma PROP_ERR ~ 0.04 (sd)

[individual_parameters]
  CL = TVCL * exp(ETA_CL)
  V1 = TVV1 * exp(ETA_V1)
  Q2 = TVQ2 * exp(ETA_Q2)
  V2 = TVV2 * exp(ETA_V2)
  Q3 = TVQ3 * exp(ETA_Q3)
  V3 = TVV3 * exp(ETA_V3)

[structural_model]
  ode(obs_cmt=central, states=[central, periph1, periph2])

[odes]
  d/dt(central)  = -(CL/V1 + Q2/V1 + Q3/V1) * central + (Q2/V2) * periph1 + (Q3/V3) * periph2
  d/dt(periph1)  =  (Q2/V1) * central - (Q2/V2) * periph1
  d/dt(periph2)  =  (Q3/V1) * central - (Q3/V3) * periph2

[scaling]
  obs_scale = V1

[error_model]
  DV ~ proportional(PROP_ERR)

[fit_options]
  method     = foce
  maxiter    = 300
  # tight ODE solver tolerance so the ODE-form OFV matches the analytical
  # closed form (the FOCE objective amplifies the default 1e-4 solver error);
  # see tests/testthat/test-ode-analytical-equivalence.R.
  ode_reltol = 1e-10
  ode_abstol = 1e-12
  covariance = true
