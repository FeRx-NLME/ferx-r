# Nested variability levels below the subject: sponsor -> study -> arm, with
# visits inside each arm (ferx-core #1082).
#
# Open the example script to step through it:
#   file.edit(system.file("examples", "ex_nested_levels.R", package = "ferx"))
# or run it in one go, printing as it goes:
#   source(system.file("examples", "ex_nested_levels.R", package = "ferx"), echo = TRUE)
#
# Data: arm-level means of a response, one row per arm and visit. 12 sponsors
# (ID), 2 studies per sponsor, 2 arms per study, 5 visits per arm: 240 rows.
# Columns ID, STUDY, ARM, TIME, DV, NARM (arm size), DOSE; ARMID, STUDYID and
# SLOT are the NONMEM coding of the same design and are not used here.
#
# The pieces:
#
#   ID is the sponsor, the top level. ETA_SP is between-sponsor variability.
#
#   level STUDY by STUDY in ID   a study is a group of rows sharing a STUDY
#       value inside one sponsor. K_ST (`kappa ... at STUDY`) is drawn once
#       per study and shared by both of its arms.
#
#   level ARM by ARM in STUDY    an arm is a group sharing an ARM value inside
#       one study. ARM is numbered 1, 2 again in every study: the groups are
#       nested by key, so ARM 1 of study 1 and ARM 1 of study 2 are different
#       arms. K_ARM (`kappa ... at ARM`) is drawn once per arm.
#
#   kappa ... weight = NARM      between-arm variability scaled by arm size.
#       The estimate is the unweighted gamma^2: an arm of NARM patients has
#       between-arm SD sqrt(gamma^2 / NARM).
#
# The data are synthetic (no patient or published data), from ferx-core's
# NONMEM anchor nonmem_anchor/nested_levels_3.{csv,ctl}, MIT-licensed:
#   https://github.com/FeRx-NLME/ferx-core/tree/main/nonmem_anchor
# NONMEM 7.6.0 codes the levels as occasion-style ETA slots with $OMEGA SAME
# and the weight by hand as KAR/SQRT(NARM). Its FOCEI estimation from the
# initial estimates below ends at OFV 107.04357106; ferx's FOCEI fit from the
# same start reaches the same optimum.

[parameters]
  theta TVE0(10.0, 0.0, 1000.0)       # response at TIME = 0
  theta TVEMAX(20.0, 0.0, 1000.0)     # maximum drug effect
  theta ED50(30.0, 0.1, 10000.0)      # dose at half-maximal effect
  theta ET50(3.0, 0.01, 1000.0)       # time to half-maximal effect

  omega ETA_SP ~ 0.09                 # between-sponsor variability on EMAX

  level STUDY by STUDY in ID
  level ARM by ARM in STUDY
  kappa K_ST ~ 0.04 at STUDY          # between-study variability
  kappa K_ARM ~ 4.0 at ARM weight = NARM   # between-arm, gamma^2 (unweighted)

  sigma ADD ~ 0.25

[individual_parameters]
  EMAX = TVEMAX * exp(ETA_SP + K_ST + K_ARM)

[structural_model]
  y = TVE0 + EMAX * DOSE / (ED50 + DOSE) * TIME / (TIME + ET50)

[error_model]
  DV ~ additive(ADD)

[fit_options]
  method     = focei
  covariance = true
