  "[parameters]",
  "  theta TVLAMBDA(0.1, 0.001, 10.0)",
  "  omega ETA_LAMBDA ~ 0.09",
  "[event_model]",
  "  cmt    = 2",
  "  type   = rtte",
  "  family = exponential",
  "  scale  = TVLAMBDA * exp(ETA_LAMBDA)"
), m)
design <- data.frame(ID = 1:60, TIME = 30, DV = 0, EVID = 0L, AMT = 0,
