# syntax=docker/dockerfile:1.7
#
# ferx (slim): R + the ferx package + the `ferx` CLI. No RStudio, no Rust
# toolchain in the final image. Meant for pipelines - targets/crew workers, CI,
# Slurm or Kubernetes jobs. The RStudio image is the root `Dockerfile`.
#
# Published by .github/workflows/docker.yml to ghcr.io/ferx-nlme/ferx-r.
#
# Build (from the repository root):
#   docker build -f Dockerfile.slim -t ferx-r:slim .
#
# Run R / the CLI on a mounted project:
#   docker run --rm -v "$PWD:/work" ferx-r:slim Rscript fit.R
#   docker run --rm -v "$PWD:/work" ferx-r:slim ferx model.ferx --data data.csv
#
# Both the R package and the CLI are built from the ferx-core commit pinned in
# src/rust/Cargo.lock, so they run the same engine (the root Dockerfile uses
# the same recipe). A ferx-core pin bump therefore needs no edit here.
#
# The R version is the base image tag, written out in both FROM lines (not an
# ARG) so Dependabot can read it: .github/dependabot.yml proposes new
# rocker/r-ver and rocker/tidyverse tags as one PR, which the docker workflow
# builds and smoke-tests before anyone merges it. Keep both FROM lines, and the
# root Dockerfile's rocker/tidyverse tag, on the same R version.

# ===========================================================================
# Build stage: Rust toolchain, ferx CLI, R package.
# ===========================================================================
FROM rocker/r-ver:4.6.0 AS build

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake pkg-config libnlopt-dev \
        curl git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Stable rustup under /opt, so the toolchain does not depend on root's $HOME.
# Both cargo builds below run on this stable toolchain.
ENV CARGO_HOME=/opt/cargo \
    RUSTUP_HOME=/opt/rustup \
    PATH=/opt/cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
        | sh -s -- -y --default-toolchain stable --profile minimal

# R dependencies first: this layer only changes with DESCRIPTION.
COPY DESCRIPTION /src/ferx/DESCRIPTION
RUN R -q -e "install.packages('remotes')" \
    && R -q -e "remotes::install_deps('/src/ferx', dependencies = NA, upgrade = 'never')"

# The `ferx` CLI, at the ferx-core commit src/rust/Cargo.lock pins. Same
# engine feature set as the R package (CARGO_FEATURES in src/Makevars).
# ferx-core is cloned to /src/core/, NOT /src/ferx-core: src/Makevars treats
# ../../ferx-core (relative to /src/ferx/src) as a sibling checkout and would
# patch it into the R package build.
# `cargo +stable`: ferx-core's rust-toolchain.toml names nightly, which rustup
# would otherwise auto-install; the engine builds on stable, as the R package
# does (src/Makevars writes `channel = stable`).
# The build tree and cargo caches are removed in the same RUN, so they never
# reach a layer (or the CI layer cache); only /usr/local/bin/ferx is kept.
COPY src/rust/Cargo.lock /src/ferx/src/rust/Cargo.lock
RUN set -eux; \
    rev="$(sed -n 's|^source = "git+https://github.com/FeRx-NLME/ferx-core?branch=main#\([0-9a-f]\{40\}\)"$|\1|p' \
             /src/ferx/src/rust/Cargo.lock | sort -u)"; \
    case "$rev" in \
        ''|*[!0-9a-f]*) \
            echo "Dockerfile.slim: expected exactly one ferx-core revision in src/rust/Cargo.lock, got: '$rev'" >&2; \
            exit 1;; \
    esac; \
    git init -q /src/core; \
    cd /src/core; \
    git fetch -q --depth 1 https://github.com/FeRx-NLME/ferx-core "$rev"; \
    git checkout -q FETCH_HEAD; \
    cargo +stable build --release --locked -p ferx-cli \
        --features ferx-core/ci,ferx-core/nn,ferx-core/survival,ferx-core/markov; \
    install -m 0755 target/release/ferx /usr/local/bin/ferx; \
    mkdir -p /usr/local/share/doc/ferx; \
    /usr/local/bin/ferx --licenses > /usr/local/share/doc/ferx/ferx-cli-LICENSES.txt; \
    grep -q 'GNU LESSER GENERAL PUBLIC LICENSE' /usr/local/share/doc/ferx/ferx-cli-LICENSES.txt; \
    printf '%s\n' "$rev" > /usr/local/share/ferx-core-rev; \
    rm -rf /src/core /opt/cargo/registry /opt/cargo/git

# The R package (rebuilds the Rust staticlib from the same pinned commit, on
# stable). Its build tree goes in the same RUN, for the same reason.
# The package's license notices (#773) are installed with it; they are also
# copied to /usr/local/share/doc/ferx, beside the CLI's, so the image carries
# them in one well-known place. The build fails if any is missing.
COPY . /src/ferx
RUN set -eu; \
    R CMD INSTALL --no-multiarch /src/ferx; \
    pkg=/usr/local/lib/R/site-library/ferx; \
    for f in LICENSE COPYRIGHTS THIRD-PARTY-NOTICES.txt licenses/LGPL-3.0.txt \
             licenses/GPL-3.0.txt licenses/LGPL-2.1.txt; do \
        test -s "$pkg/$f"; \
        mkdir -p "$(dirname /usr/local/share/doc/ferx/$f)"; \
        cp "$pkg/$f" "/usr/local/share/doc/ferx/$f"; \
    done; \
    rm -rf /src/ferx /opt/cargo/registry /opt/cargo/git /tmp/Rtmp*

# ===========================================================================
# Runtime stage: R + installed packages + the CLI. No compilers, no Rust.
# ===========================================================================
FROM rocker/r-ver:4.6.0

ARG FERX_R_REVISION=unknown
LABEL org.opencontainers.image.title="ferx-r (slim)" \
      org.opencontainers.image.description="R + the ferx NLME package + the ferx CLI, no RStudio" \
      org.opencontainers.image.source="https://github.com/FeRx-NLME/ferx-r" \
      org.opencontainers.image.licenses="MIT AND LGPL-3.0-or-later AND LGPL-2.1-or-later" \
      org.opencontainers.image.revision="${FERX_R_REVISION}"

# rocker/r-ver installs packages into /usr/local/lib/R/site-library.
COPY --from=build /usr/local/lib/R/site-library /usr/local/lib/R/site-library
COPY --from=build /usr/local/bin/ferx /usr/local/bin/ferx
COPY --from=build /usr/local/share/ferx-core-rev /usr/local/share/ferx-core-rev
# License texts and notices for the package and the CLI: ferx's own code is
# MIT, and both link ferx-search (LGPL-3.0-or-later) and NLopt
# (LGPL-2.1-or-later). COPYRIGHTS says what applies to what.
COPY --from=build /usr/local/share/doc/ferx /usr/local/share/doc/ferx

# Unprivileged default user, uid 1000 so files written to a mounted project
# usually belong to the host user. Ubuntu 24.04 bases ship an `ubuntu` user at
# uid 1000; drop it first. Run with `--user "$(id -u):$(id -g)"` to match any
# other host uid. /work is the conventional mount point.
RUN if id -u ubuntu >/dev/null 2>&1; then userdel --remove ubuntu; fi \
    && useradd --create-home --uid 1000 --user-group --shell /bin/bash ferx \
    && mkdir -p /work && chown ferx:ferx /work
USER ferx
WORKDIR /work

CMD ["R"]
